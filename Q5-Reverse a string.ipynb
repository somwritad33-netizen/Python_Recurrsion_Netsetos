    "s='NETSETOS'\n",
    "\n",
    "def rev_string(s):\n",
    "    if len(s)<1:\n",
    "        return ''\n",
    "    else:\n",
    "        return s[-1]+rev_string(s[:-1])\n",
    "\n",
    "\n",
    "\n",
    "print(rev_string(s))"
